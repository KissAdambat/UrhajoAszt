<Window x:Class="UrhajoAszt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UrhajoAszt"
        mc:Ignorable="d"
        Title="Űrhajók" Height="630" Width="1150">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="9*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1" Orientation="Vertical" Background="#1B2A3A" Margin="0,10,0,15">
            <TextBlock Text="Űrhajó műveletek" Foreground="White" FontSize="24" FontWeight="Bold"
                       Margin="0,0,0,35"/>

            <Button x:Name="btnBetoltes" Content="Adatok betöltése" Height="25" Margin="10,0,10,10"
                    Click="btnBetoltes_Click"/>
            <Button x:Name="btnDarab" Content="Hány űrhajó van?" Height="25" Margin="10,0,10,10"
                    Click="btnDarab_Click"/>
            <Button x:Name="btnHatotav" Content="Melyiknek a legnagyobb a hatótávja?" Height="25" Margin="10,0,10,10"
                    Click="btnHatotav_Click"/>
            <Button x:Name="btnSikeres" Content="Kik voltak sikeres küldetésen?" Height="25" Margin="10,0,10,10"
                    Click="btnSikeres_Click"/>
            <Button x:Name="btnAtlag" Content="Átlagos legénységszám" Height="25" Margin="10,0,10,10"
                    Click="btnAtlag_Click"/>
            <Button x:Name="btnGyartok" Content="Gyártók szerinti csoportosítás" Height="25" Margin="10,0,10,10"
                    Click="btnGyartok_Click"/>
            <Button x:Name="btnKereses" Content="Keresés név alapján" Height="25" Margin="10,0,10,10"
                    Click="btnKereses_Click"/>

            <TextBox x:Name="txtKereses" Height="25" Margin="10,0,10,10" VerticalContentAlignment="Center"/>
            <TextBox x:Name="txtEredmeny" Height="25" Margin="10,0,10,0" IsReadOnly="True"
                     Background="LightGray" VerticalContentAlignment="Center"/>
        </StackPanel>

        <DataGrid x:Name="dgUrhajok" Grid.Column="2" Margin="0,10,15,15"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="Black" VerticalGridLinesBrush="Black">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nev" Binding="{Binding Nev}" Width="*"/>
                <DataGridTextColumn Header="Legenyseg" Binding="{Binding Legenyseg}" Width="*"/>
                <DataGridTextColumn Header="MaxHatotav" Binding="{Binding MaxHatotav}" Width="*"/>
                <DataGridTextColumn Header="UzemenyagSzint" Binding="{Binding UzemenyagSzint}" Width="*"/>
                <DataGridTextColumn Header="Gyarto" Binding="{Binding Gyarto}" Width="*"/>
                <DataGridTextColumn Header="KuldetesStatusz" Binding="{Binding KuldetesStatusz}" Width="*"/>
                <DataGridTextColumn Header="InditasEve" Binding="{Binding InditasEve}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>
